{
  "name": "@elffuss/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Task modules for the browser: background removal, OCR, object detection, depth, text-to-image, video from a photo and video from a text, and music, sound effects and speech from text, on WebGPU or WebAssembly.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./core": "./sdk/core/index.js",
    "./remove-bg": "./sdk/remove-bg/index.js",
    "./remove-bg/sizes": "./sdk/remove-bg/sizes.js",
    "./depth": "./sdk/depth/index.js",
    "./depth/sizes": "./sdk/depth/sizes.js",
    "./detect": "./sdk/detect/index.js",
    "./detect/sizes": "./sdk/detect/sizes.js",
    "./ocr": "./sdk/ocr/index.js",
    "./ocr/sizes": "./sdk/ocr/sizes.js",
    "./audio": "./sdk/audio/index.js",
    "./audio/sizes": "./sdk/audio/sizes.js",
    "./text-to-image": "./sdk/text-to-image/index.js",
    "./text-to-image/sizes": "./sdk/text-to-image/sizes.js",
    "./video": "./sdk/video/index.js",
    "./video/sizes": "./sdk/video/sizes.js",
    "./video/encode": "./sdk/video/encode.js",
    "./video/render": "./sdk/video/render.js",
    "./video-gen": "./sdk/video-gen/index.js",
    "./video-gen/sizes": "./sdk/video-gen/sizes.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/vendor.mjs --ensure && node --test \"tests/unit/*.test.mjs\"",
    "vendor:fetch": "node scripts/vendor.mjs --fetch",
    "test:browser": "node tests/browser/run.mjs",
    "build": "node scripts/build.mjs",
    "registry": "node scripts/build-registry.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "docs": "node scripts/build-docs.mjs",
    "nginx": "node deploy/build-nginx.mjs",
    "sweep": "node scripts/sweep.mjs"
  }
}
